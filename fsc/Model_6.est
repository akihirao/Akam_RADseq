1  TDIV_01      unif     10     5e5   output
1  TPLUS        unif     10     5e5   hide
0  m01          logunif  1e-8   5e-2  output
0  m10          logunif  1e-8   5e-2  output
0  m02          logunif  1e-8   5e-2  output
0  m20          logunif  1e-8   5e-2  output
0  m12          logunif  1e-8   5e-2  output
0  m21          logunif  1e-8   5e-2  output
0  md1          logunif  1e-8   5e-2  output
0  md2          logunif  1e-8   5e-2  output


[COMPLEX PARAMETERS]
1  TDIV_ANC = TDIV_01+TPLUS        output

